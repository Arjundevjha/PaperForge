{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@paperforge/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@paperforge/questions": [
        "../../packages/questions/src/index.ts"
      ],
      "@paperforge/dedup": [
        "../../packages/dedup/src/index.ts"
      ],
      "@paperforge/classification": [
        "../../packages/classification/src/index.ts"
      ],
      "@paperforge/pdf": [
        "../../packages/pdf/src/index.ts"
      ],
      "@paperforge/worksheets": [
        "../../packages/worksheets/src/index.ts"
      ],
      "@paperforge/db": [
        "../../packages/db/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
