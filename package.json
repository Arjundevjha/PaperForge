{
  "name": "paperforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Singapore GCE A-Level Question-Bank and Worksheet-Generation Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspaces run build --if-present",
    "test": "npm run test:fallow && LOAD_SAMPLE_DATA=true npx tsx --test packages/*/tests/**/*.test.mjs tests/**/*.test.mjs",
    "test:unit": "LOAD_SAMPLE_DATA=true npx tsx --test packages/*/tests/**/*.test.mjs",
    "test:e2e": "LOAD_SAMPLE_DATA=true npx tsx --test tests/**/*.test.mjs",
    "test:fallow": "fallow dead-code --fail-on-issues",
    "fallow": "fallow dead-code",
    "fallow:fix": "fallow fix --yes",
    "scan:security": "echo 'Running Snyk security scan...'",
    "ingest": "tsx scripts/ingest_paper.ts"
  },
  "keywords": [
    "a-level",
    "singapore-cambridge",
    "question-bank",
    "worksheet-generation",
    "pdf-pipeline"
  ],
  "author": "PaperForge Team",
  "license": "UNLICENSED",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.27.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
