# ==============================================================================
# PaperForge — Environment Configuration Blueprint
# ==============================================================================

# --- Application Environment ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL + Drizzle ORM) ---
# When unset or empty, PaperForge runs in zero-config in-memory dev mode with seed data.
# When provided, PaperForge connects to live PostgreSQL (Local Docker, Neon, Supabase, AWS RDS).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paperforge
# Optional Connection Pool settings:
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false

# --- Authentication & Session Security ---
# Secret used for signing JWTs, session tokens, and CSRF protection (min 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SECRET=paperforge_development_secret_key_minimum_32_characters_long
AUTH_TRUST_HOST=true
# Default admin user email for initial seed bootstrap:
ADMIN_DEFAULT_EMAIL=arjun.dev.jha@paperforge.sg
ADMIN_DEFAULT_PASSWORD=ChangeMeInProduction123!

# --- Redis & Worker Pool (BullMQ Background Ingestion) ---
# Used for background PDF parsing and scheduled 90-day sync jobs
REDIS_URL=redis://localhost:6379

# --- Object Storage (Source PDFs & Compiled Cambridge Worksheets) ---
# Options: 'local' (local filesystem in development) or 's3' (AWS S3, Cloudflare R2, MinIO)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage/pdfs
# If STORAGE_TYPE=s3:
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=paperforge-examinations
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Cambridge PDF & Pipeline Parameters ---
# Maximum uploaded PDF file size in megabytes (default 50MB)
MAX_PDF_SIZE_MB=50
# Singapore examination synchronization interval in days
UPDATE_INTERVAL_DAYS=90
